# Server port (Cloud Run sets this automatically to 8080)
PORT=8080

# Google Gemini API key used for natural language omni-search, mood recommendations, and owner analytics
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (defaults to gemini-2.5-flash for high speed and multimodal reasoning)
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL connection string for Google Cloud SQL in Mumbai (asia-south1)
# Leave this variable blank or commented out to run zero-config embedded PGlite with @haathie/pgmb
# For example: postgresql://postgres:your_password@10.x.x.x:5432/cafe
# For Cloud SQL Auth Proxy: postgresql://postgres:your_password@127.0.0.1:5432/cafe
DATABASE_URL=

# Subscription group identifier for the @haathie/pgmb real-time table mutation broker
# This coordinates Server-Sent Events (SSE) across multiple Cloud Run container instances
PGMB_GROUP_ID=brewmesh-server
